# Fail fast if a dev's Node version drifts from what's declared in package.json#engines.
engine-strict=true

# Azure Functions/Oryx expect a flat, hoisted node_modules layout; pnpm's default
# isolated/symlinked layout has caused module-resolution failures in Functions
# deployments in the wild. Revisit (e.g. `pnpm deploy` isolated output) once
# apps/api has real code and this gets tested for real — see docs/tech-stack.md.
node-linker=hoisted
