# Entra External ID (see docs/architecture.md § Open decisions #1) — values from
# the app registration in the Entra portal:
#   VITE_ENTRA_CLIENT_ID  — Overview page, "Application (client) ID"
#   VITE_ENTRA_AUTHORITY  — https://<tenant>.ciamlogin.com/<tenant-id> (or your
#                           CIAM custom domain), NOT the plain tenant ID alone
#   VITE_ENTRA_API_SCOPE  — "Expose an API" page, the full scope URI
#                           (api://<app-id>/skydispatch_access)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_API_SCOPE=

# Dev/test only — skips the /dispatch login redirect entirely and lets every
# page render as if signed in with the required role. Set by playwright.config.ts
# for e2e runs; never set this in a real deployed build's env/config, or it
# silently defeats the whole auth feature.
VITE_E2E_BYPASS_AUTH=
