# Dependencies
node_modules/
.pnpm-store/

# Azurite (Storage emulator) local data/debug log — `.azurite/` is where this
# project's own `pnpm azurite` script points it (see root package.json), but
# VS Code's built-in Azurite extension auto-starts its own instance and
# defaults to writing straight into whatever folder is open (confirmed:
# landed in apps/api/) — these patterns catch that regardless of location.
.azurite/
AzuriteConfig
__azurite_db_*__.json
__blobstorage__/
__queuestorage__/

# Build output
dist/
build/

# Azure Functions / SWA
apps/api/local.settings.json
.swa/
api-deploy/

# Env / secrets
.env
.env.local

# Playwright
test-results/
playwright-report/
blob-report/

# Editor / OS
.DS_Store
*.log

# Claude Code local overrides (per-user, not shared)
.claude/settings.local.json
